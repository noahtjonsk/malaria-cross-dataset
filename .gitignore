# Source datasets: downloaded, read-only, far too large to track.
cell_images_NIH/
malaria_BBBC041/
MP-IDB-The-Malaria-Parasite-Image-Database-*/
NIH-NLM-ThinBloodSmearsPf/

# Generated crops: ~87k files, rebuilt by scripts/build_crops.py
data/crops/

# Per-cell manifests are regenerated deterministically by build_crops.py.
# nih_split.csv and mpidb_stage_audit.csv are NOT ignored: the split pins the
# exact train/val/test rows every model must share, and the audit records where
# each MP-IDB stage label came from.
data/manifests/all_cells.csv
data/manifests/bbbc041_cells.csv
data/manifests/nih_cells.csv
data/manifests/mpidb_cells.csv
data/manifests/nihpoly_cells.csv
data/manifests/mpidb_wholecell_cells.csv
data/manifests/masked_*_cells.csv
data/manifests/colour_*_cells.csv

# 62 MB of per-image statistics, rebuilt by scripts/compute_stats.py
outputs/tables/cell_stats.csv
outputs/tables/cell_stats_*.csv

# Shareable HTML export, regenerated on demand with:
#   python -m nbconvert --to html --output-dir outputs outputs/01_eda_run.ipynb
outputs/01_eda_run.html

# Trained weights (0.5 GB per VGG-16), per-cell predictions and the Colab
# upload archives: rebuilt by train.py, evaluate.py and pack_for_colab.py
models/
outputs/predictions/
colab/

# Course materials and submitted deliverables: not ours to publish, or kept
